# Copy this file to .env.local and fill in your own values.

# Supabase: Project Settings > API Keys. Use the publishable key (sb_publishable_...),
# never the secret key (sb_secret_...). The publishable key is meant to be public:
# the database's row-level security decides what it can reach.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
